<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GamiAutoClicker.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="OnUnloaded">
    <NavigationView
        x:Name="SettingsNavigation" x:Uid="SettingsWindow_SettingsNavigation"
        CompactModeThresholdWidth="0"
        ExpandedModeThresholdWidth="750"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="{x:Bind State.IsPaneOpen, Mode=TwoWay}"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        Loaded="OnNavigationLoaded"
        ItemInvoked="OnNavigationItemInvoked"
        OpenPaneLength="150"
        PaneDisplayMode="Auto"
        PaneOpening="OnPaneOpening"
        SelectedItem="{x:Bind GetNavigationItem(State.SelectedSection), Mode=TwoWay, BindBack=UpdateSelectedSection}"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="GeneralNavigationItem" x:Uid="SettingsWindow_GeneralNavigationItem">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AppearanceNavigationItem" x:Uid="SettingsWindow_AppearanceNavigationItem">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SaveButton" x:Uid="SettingsSaveButton"
                                SelectsOnInvoked="False">
                <NavigationViewItem.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="NavigationViewItemBackground" ResourceKey="AccentButtonBackground" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed" />
                                <StaticResource x:Key="NavigationViewItemBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled" />
                                <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="AccentButtonForeground" />
                                <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="AccentButtonForegroundPressed" />
                                <StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="NavigationViewItemBackground" ResourceKey="AccentButtonBackground" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed" />
                                <StaticResource x:Key="NavigationViewItemBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled" />
                                <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="AccentButtonForeground" />
                                <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="AccentButtonForegroundPressed" />
                                <StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="NavigationViewItemBackground" ResourceKey="AccentButtonBackground" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed" />
                                <StaticResource x:Key="NavigationViewItemBackgroundDisabled" ResourceKey="AccentButtonBackgroundDisabled" />
                                <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="AccentButtonForeground" />
                                <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver" />
                                <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="AccentButtonForegroundPressed" />
                                <StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="AccentButtonForegroundDisabled" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </NavigationViewItem.Resources>
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Save" />
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock x:Uid="SettingsSaveHint" TextWrapping="Wrap" MaxWidth="280" />
                    </ToolTip>
                </ToolTipService.ToolTip>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="SaveError" Severity="Error" IsOpen="False" />
            <ContentControl Grid.Row="1"
                x:Name="SettingsContent"
                Content="{x:Bind GetSectionPage(State.SelectedSection), Mode=OneWay}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>
    </NavigationView>
</Page>
