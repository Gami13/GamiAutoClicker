<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GamiAutoClicker.Pages.Settings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:GamiAutoClicker.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GamiAutoClicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Loaded="OnRootGridLoaded"
        SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="Localized1" x:Uid="AppearancePage_Localized1" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock
 x:Name="Localized2" x:Uid="AppearancePage_Localized2"                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <components:RestoreDefaultsButton
                x:Name="RestoreDefaultsControl"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnRestoreDefaultsClick" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Margin="24,0,24,8"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsRightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SettingsAdvancedRow" Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE790;" />
                        <TextBlock
 x:Name="Localized3" x:Uid="AppearancePage_Localized3"                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            />
                    </StackPanel>
                    <TextBlock
 x:Name="Localized4" x:Uid="AppearancePage_Localized4"                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Padding="12"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Spacing="3">
                        <TextBlock x:Name="PreviewMaterialText" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="PreviewThemeText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PreviewOverrideText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Localized5" x:Uid="AppearancePage_Localized5" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
 x:Name="Localized6" x:Uid="AppearancePage_Localized6"                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox
                        x:Name="BackdropMaterialComboBox" x:Uid="AppearancePage_BackdropMaterialComboBox"
                        SelectionChanged="OnMaterialChange" />
                    <TextBlock
 x:Name="Localized7" x:Uid="AppearancePage_Localized7"                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />

                    <ComboBox
                        x:Name="ThemeComboBox" x:Uid="AppearancePage_ThemeComboBox"
                        SelectionChanged="OnThemeChange" />
                    <TextBlock
 x:Name="Localized8" x:Uid="AppearancePage_Localized8"                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    x:Name="AdvancedTuningCard"
                    Grid.Row="2"
                    Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Localized9" x:Uid="AppearancePage_Localized9" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
 x:Name="Localized10" x:Uid="AppearancePage_Localized10"                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="OverrideDefaultsToggleSwitch" x:Uid="AppearancePage_OverrideDefaultsToggleSwitch"
                        Toggled="OnOverridesChange" />

                    <StackPanel x:Name="AdvancedControlsPanel" Spacing="10">

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="TintColorColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="TintColorRow" Height="0" />
                            </Grid.RowDefinitions>
                            <components:ColorPickerFlyoutButton
                                x:Name="FallbackColorPicker" x:Uid="AppearancePage_FallbackColorPicker"
                                ColorChanged="OnFallbackColorChange"
                                />
                            <components:ColorPickerFlyoutButton
                                x:Name="TintColorPicker" x:Uid="AppearancePage_TintColorPicker"
                                Grid.Column="1"
                                ColorChanged="OnTintColorChange"
                                />
                        </Grid>

                        <components:LabeledPercentageSlider
                            x:Name="TintOpacitySlider" x:Uid="AppearancePage_TintOpacitySlider"
                            PercentageChanged="OnTintOpacityChange" />

                        <components:LabeledPercentageSlider
                            x:Name="LuminosityOpacitySlider" x:Uid="AppearancePage_LuminosityOpacitySlider"
                            PercentageChanged="OnLuminosityOpacityChange" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
