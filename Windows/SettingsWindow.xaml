<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GamiAutoClicker.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <NavigationView
        x:Name="SettingsNavigation"
        PaneTitle="Settings"
        PaneDisplayMode="Auto"
        OpenPaneLength="200"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="800"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        Loaded="OnNavigationLoaded"
        SizeChanged="OnNavigationSizeChanged"
        PaneOpening="OnPaneOpening"
        PaneClosed="OnPaneClosed"
        DisplayModeChanged="OnNavigationDisplayModeChanged"
        SelectionChanged="OnNavigationSelectionChanged">
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush
                            x:Key="NavigationViewDefaultPaneBackground"
                            Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="GeneralNavigationItem" Content="General">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AppearanceNavigationItem" Content="Appearance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <ContentControl x:Name="SettingsContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
